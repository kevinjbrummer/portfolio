---
import "../styles/global.css";
---

<section class="hero">
    <div class="hero__content">
        <p class="hero__eyebrow">
            Kevin Brummer | Software Engineer (Cloud & Data Platforms)
        </p>
        <h1 class="headline">
            Building Scalable
            <span class="rotating">
                <span>Cloud</span>
                <span>Data</span>
                <span>Distributed</span>
            </span>
            Systems
        </h1>
        <p class="hero__subtext">
            Software engineer with 4+ years of experience building cloud-native,
            event-driven systems on AWS
        </p>
        <div class="hero__actions">
            <a href="/docs/resume.pdf" target="_blank" class="btn btn-primary"
                >View Resume</a
            >
            <a href="/case-studies" class="btn btn-secondary">Case Studies</a>
            <a href="/projects" class="btn btn-secondary">Projects</a>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
        background: linear-gradient(135deg, var(--bg), hsl(220, 40%, 15%));
        color: var(--text);
        text-align: center;
    }

    .hero:before {
        content: "";
        position: absolute;
        width: 600px;
        height: 600px;
        background: radial-gradient(var(--accent), transparent 70%);
        filter: blur(120px);
        opacity: 0.2;
        z-index: 0;
    }

    .hero__content {
        position: relative;
        z-index: 1;
    }

    .hero__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--accent);
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    .headline {
        font-size: clamp(2.5rem, 6vw, 4rem);
        line-height: 1.1;
    }

    .hero__subtext {
        color: var(--muted);
        font-size: clamp(1rem, 2vw, 1.25rem);
        margin-bottom: 2rem;
    }

    .hero__actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .rotating {
        display: inline-block;
        height: 1em;
        overflow: hidden;
        vertical-align: bottom;
        color: var(--accent);
    }

    .rotating span {
        display: block;
        line-height: 1em;
        text-align: left;
    }

    .rotating span {
        animation: rotateWords 9s infinite cubic-bezier(0.77, 0, 0.175, 1);
    }

    @keyframes rotateWords {
        0%,
        20% {
            transform: translateY(0%);
        }
        33%,
        53% {
            transform: translateY(-100%);
        }
        66%,
        86% {
            transform: translateY(-200%);
        }
        100% {
            transform: translateY(0%);
        }
    }

    /* animate the whole stack */
    .rotating {
    }
</style>
